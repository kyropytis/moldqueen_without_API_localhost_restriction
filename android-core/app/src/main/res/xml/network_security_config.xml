<?xml version="1.0" encoding="utf-8"?>
<!-- Permit cleartext HTTP universally so the WebView can load the locally-served client 
     and connect to remote WebSocket IPs (e.g. 192.168.x.x) on the local network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
